{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketing-practitioner.local/schemas/behavioral-case-v1.json",
  "type": "object",
  "required": ["schema_version", "cases"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "version", "family", "prompt", "input_files", "hard_predicates", "review_criteria", "forbidden_disclosures", "expected_relation", "provenance"],
        "additionalProperties": false
      }
    }
  }
}
